# variaveis de ambiente
# Para rodar localmente o projeto, deve criar um arquivo .env com as mesmas informações de variaveis de ambiente abaixo.

# porta em que o servidor vai rodar
PORT=3000

# variaveis de conexao com o banco de dados Postgres (mesmas previstas para o docker-compose.yml)
POSTGRES_DB=giross
POSTGRES_USER=giross
POSTGRES_PASSWORD=giross_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://giross:giross_dev@localhost:5432/giross

# variaveis de conexao com a API de geocoding (AwesomeAPI)
GEOCODING_API_URL=https://cep.awesomeapi.com.br/json/
GEOCODING_TIMEOUT_MS=5000

# variaveis de conexao com o Redis (mesmas previstas para o docker-compose.yml)
REDIS_PORT=6379
REDIS_PASSWORD=giross_redis_dev
REDIS_URL=redis://default:giross_redis_dev@localhost:6379

# variaveis de limite de requisições
API_RATE_LIMIT_PER_MINUTE=60
CACHE_DELETE_RATE_LIMIT_PER_MINUTE=5
GEOCODING_RATE_LIMIT_PER_MINUTE=30

# Número de proxies na frente da API. LOCAL = VAZIO
TRUST_PROXY=
